{
  "name": "gecko",
  "purpose": "Job discovery, resume tailoring and generation, and application tracking",
  "master_resume": "input/master-resume/Dave-Call-Resume.txt",
  "formatting_model": "input/master-resume/MODEL-GECKO-PRODUCT_Dave_Call_Resume.pdf",
  "resume_output_dir": "output/resumes",
  "job_tracker": "Google Sheets",
  "google_sheets_module": "job-scout/google_tracker.py",
  "job_tracker_script": "scripts/manage_job_tracker.py",
  "target_pages": 2,
  "default_font_size_pt": 10.5,
  "line_spacing": 1.15,
  "filename_pattern": "Dave-Call+<Company-Name>+<Job-Title>+<job-number>.docx",
  "job_description_pattern": "<Company-Name>+<job-number>.md"
}
