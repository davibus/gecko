  "default_font_size_pt": 11,
  "line_spacing": 1.15,
  "filename_pattern": "Dave-Call+<Company-Name>+<job-number>.docx",
  "match_report_pattern": "Dave-Call+<Company-Name>+<job-number>.md",
  "job_description_pattern": "<Company-Name>+<job-number>.md"
}
