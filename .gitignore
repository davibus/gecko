.DS_Store
Thumbs.db
~$*.docx
*.tmp
~$*.xlsx
__pycache__/
*.py[cod]
/usage/*.sqlite3
/usage/*.sqlite3-*
/usage/*.xlsx
/usage/*.snapshot.json
/usage/*.inspect.ndjson
/usage/*.tmp.xlsx*
/usage/node_modules/
/reports/resume-similarity/node_modules/
.tools/

# Google Drive native-document pointer files are not portable file contents.
*.gsheet
*.gdoc

# Local Google Drive tracker shortcut and archival resume materials.
/output/resumes/perfected-gecko-resumes/

# Reproducible working and diagnostic artifacts
scratch/*
!scratch/.gitkeep
tmp/
output/*.log
/output/attached-resumes/
output/*.xlsx
output/apply-queue-results.md

# Local credentials and environment overrides
.env
.env.*
!.env.example

# Google service-account credentials must never be committed.
/key/
/.secrets/
google-sheets-service-account.json
*service-account-key*.json
gmail-oauth-client*.json
gmail-oauth-token*.json
gmail-response-state.json
job-scout/data/gmail-response-state.json
job-scout/data/firecrawl_discovery.sqlite*
job-scout/data/firecrawl_discovery.lock

# Per-job local OpenClaw handoffs contain resume paths and application URLs.
/openclaw/application-queue/*/

# Editable personal applicant answers remain local.
/openclaw/application-answers.md

# Local Playwright application evidence contains personal data and browser state.
/reports/playwright-pilot/

# Oversized local discovery report; retain on disk only.
/reports/discovery-audit/20261013/retry/greenhouse.json

# Local candidate match evidence contains excerpts from the personal master.
/job-scout/data/resume-match/

# Runtime databases and consistent recovery copies live outside Git.
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.db
*.db-*
*.sqlite.gz
*.sqlite3.gz
/reports/sqlite-backups/
/reports/database-maintenance/
*.partial

# Retained feed snapshots have verified external archives and small manifests.
/reports/discovery/**/source-*.json
/reports/discovery/**/additional-source-rows.json
# Maintenance audits and temporary Git indexes are local runtime artifacts.
/reports/storage-maintenance/
*.bundle
*.git-backup.zip
