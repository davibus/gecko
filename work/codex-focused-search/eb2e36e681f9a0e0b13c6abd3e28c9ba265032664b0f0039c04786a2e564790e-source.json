s-cdn.breezy.hr/breezy-portal/javascripts/v3/index.js?v=6t5-196s2vi\"></script><link rel=\"stylesheet\" href=\"https://assets-cdn.breezy.hr/breezy-portal/dependencies/20170112/fancybox/source/jquery.fancybox.css\" type=\"text/css\" media=\"screen\"><script type=\"text/javascript\" src=\"https://assets-cdn.breezy.hr/breezy-portal/dependencies/20170112/fancybox/source/jquery.fancybox.pack.js\"></script><script>$(function () {\n\t$('[data-toggle=\"tooltip\"]').tooltip()\n})\n</script><title>Head of Paid Media at Linear</title><meta name=\"description\" content=\"Click the link here to see the job description and apply! 🚀\"><link rel=\"canonical\" href=\"https://linear-agency.breezy.hr/p/6ef6bc1c2419-head-of-paid-media\"><meta property=\"og:type\" content=\"website\"><meta property=\"og:image\" content=\"https://linear-agency.breezy.hr/p/6ef6bc1c2419-head-of-paid-media/social/image?linkedin=1779899457868\"><meta property=\"og:title\" content=\"Head of Paid Media at Linear\"><meta property=\"og:url\" content=\"https://linear-agency.breezy.hr/p/6ef6bc1c2419-head-of-paid-media\"><meta property=\"og:description\" content=\"Click the link here to see the job description and apply! 🚀\"><meta name=\"twitter:card\" content=\"summary_large_image\"><meta name=\"twitter:title\" content=\"Head of Paid Media at Linear\"><meta name=\"twitter:description\" content=\"Click the link here to see the job description and apply! 🚀\"><meta name=\"twitter:image\" content=\"https://linear-agency.breezy.hr/p/6ef6bc1c2419-head-of-paid-media/social/image?linkedin=1779899457868\"><meta name=\"twitter:site\" content=\"@Breezy_HR\"><meta name=\"twitter:label2\" content=\"Company\"><meta name=\"twitter:data2\" content=\"Linear Agency\"><meta name=\"twitter:label1\" content=\"Location\"><meta name=\"twitter:data1\" content=\"Remote Worldwide\"><script type=\"application/ld+json\">{\"@context\":\"http://schema.org\",\"@type\":\"WebSite\",\"name\":\"Breezy HR\",\"alternateName\":\"Breezy HR: Modernize y