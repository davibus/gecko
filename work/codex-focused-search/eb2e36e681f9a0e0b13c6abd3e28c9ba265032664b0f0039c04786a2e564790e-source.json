-align: center; width: 48px; }\r\n\r\n#st-1 .st-total.st-hidden { display: none; }\r\n\r\n#st-1 .st-total > span { display: block; font-size: 18px; line-height: 21px; padding: 0px; }\r\n\r\n#st-1 .st-total > span.st-shares { font-size: 11px; line-height: 11px; }\r\n\r\n#st-1 .st-toggle { left: -48px; transition: 0.2s ease-in; background: rgb(204, 204, 204); border-bottom-right-radius: 0px; color: white; cursor: pointer; font-size: 24px; line-height: 24px; position: relative; text-align: center; width: 48px; }\r\n\r\n#st-1.st-hidden .st-toggle { border-top-right-radius: 0px; }\r\n\r\n#st-1.st-left .st-toggle .st-left { display: inline-block; }\r\n\r\n#st-1.st-left.st-hidden .st-toggle .st-left { display: none; }\r\n\r\n#st-1.st-left .st-toggle .st-right { display: none; }\r\n\r\n#st-1.st-left.st-hidden .st-toggle .st-right { display: inline-block; }\r\n\r\n#st-1:hover .st-toggle { left: 0px; }\r\n\r\n#st-1.st-hidden:hover .st-toggle { left: 48px; }\r\n\r\n#st-1.st-toggleable:hover .st-btn.st-last { border-bottom-right-radius: 0px; }\r\n\r\n#st-1.st-toggleable:hover .st-btn.st-last:hover { border-bottom-right-radius: 0px; }\r\n\r\n#st-1 .st-btn:hover { border-bottom-right-radius: 0px; border-top-right-radius: 0px; }\r\n\r\n#st-1.st-has-labels .st-btn:hover { width: 120px; }\r\n\r\n#st-1:not(.st-has-labels) .st-btn:hover { width: 62px; }\r\n\r\n#st-1 .st-btn.st-hide-label:hover { width: 62px; }\r\n\r\n#st-1 .st-btn:hover > svg { margin-left: 5px; }\r\n\r\n#st-1 .st-btn:hover > img { margin-left: 5px; }\r\n\r\n#st-1 .st-btn:hover > span { opacity: 1; display: inline-block; left: 0px; }\r\n\r\n@media (max-width: 1024px) {\r\n  #st-1 .st-btn:hover > svg { margin-left: 0px; }\r\n  #st-1 .st-btn:hover > span { display: none; }\r\n}\r\n\r\n@media (max-width: 1024px) {\r\n  #st-1 { inset: auto 0px 0px; display: flex; width: 100%; }\r\n  #st-1.st-hidden { bottom: -48px; width: 100%; }\r\n  #st-1.st-hidden.st-left { left: 0px; }\r\n  #st-1.st-hidden.st-right { right: 0px; }\r\n  #st-1 > div { clear: none; flex: 1 1 0%; float: none; }\r\n  #st-1 .st-total { background: rgb(255, 255, 255); padding: 6px 8px; }\r\n  #st-1 .st-btn { text-align: center; width: auto; border-radius: 0px !important; }\r\n  #st-1 .st-btn > span { display: none; }\r\n  #st-1 .st-toggle { display: none; }\r\n  body { padding-bottom: 48px; }\r\n}\r\n\r\n#st-1 .st-btn[data-network=\"facebook\"] { background-color: rgb(66, 103, 178); }\r\n\r\n#st-1 .st-btn[data-network=\"facebook\"] img { }\r\n\r\n#st-1 .st-btn[data-network=\"facebook\"] > span { color: rgb(255, 255, 255); }\r\n\r\n#st-1 .st-btn[data-network=\"facebook\"] > svg { fill: rgb(255, 255, 255); }\r\n\r\n#st-1 .st-btn[data-network=\"twitter\"] { background-color: rgb(0, 0, 0); }\r\n\r\n#st-1 .st-btn[data-network=\"twitter\"] img { }\r\n\r\n#st-1 .st-btn[data-network=\"twitter\"] > span { color: rgb(255, 255, 255); }\r\n\r\n#st-1 .st-btn[data-network=\"twitter\"] > svg { fill: rgb(255, 255, 255); }\r\n\r\n#st-1 .st-btn[data-network=\"linkedin\"] { background-color: rgb(0, 119, 181); }\r\n\r\n#st-1 .st-btn[data-network=\"linkedin\"] img { }\r\n\r\n#st-1 .st-btn[data-network=\"linkedin\"] > span { color: rgb(255, 255, 255); }\r\n\r\n#st-1 .st-btn[data-network=\"linkedin\"] > svg { fill: rgb(255, 255, 255); }\r\n\r\n#st-1 .st-btn[data-network=\"snapchat\"] > span { color: rgb(51, 51, 51); }</style><base href=\"https://linear-agency.breezy.hr/\"><meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\"><meta name=\"viewport\" content=\"initial-scale=1.0,width=device-width,user-scalable=0, minimal-ui\"><link rel=\"icon\" sizes=\"192x192\" href=\"https://assets-cdn.breezy.hr/favicon_192.png\"><link rel=\"icon\" sizes=\"128x128\" href=\"https://assets-cdn.breezy.hr/favicon_128.png\"><link rel=\"apple-touch-icon\" sizes=\"128x128\" href=\"https://assets-cdn.breezy.hr/favicon_128.png\"><link rel=\"apple-touch-icon-precomposed\" sizes=\"128x128\" href=\"https://assets-cdn.breezy.hr/favicon_128.png\"><link rel=\"shortcut i