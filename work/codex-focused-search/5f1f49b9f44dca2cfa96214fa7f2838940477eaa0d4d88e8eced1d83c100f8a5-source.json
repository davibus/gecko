https://platform-api.sharethis.com/js/sharethis.js#property=643ef4e9c1f1cd00199ca696&amp;product=sop\" async=\"async\"></script><script type=\"text/javascript\" src=\"https://assets-cdn.breezy.hr/breezy-portal/javascripts/v3/polyglot.min.js?v=2bq-1us5ftb\"></script><script id=\"translateScript\" type=\"text/javascript\" src=\"https://assets-cdn.breezy.hr/breezy-portal/javascripts/v3/translate.breezy.js?v=awfw-ecrhol\"></script><link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css?family=Nunito:300\"><link rel=\"stylesheet\" href=\"https://assets-cdn.breezy.hr/breezy-hr/dependencies/fontawesome/v6.4.2-pro/css/all.css\"><!--if portal.layout.type === 'bold'--><link rel=\"stylesheet\" href=\"https://assets-cdn.breezy.hr/breezy-portal/dependencies/20170112/bootstrap.css\"><link rel=\"stylesheet\" href=\"https://assets-cdn.breezy.hr/breezy-portal/dependencies/20170112/animate.css\"><link rel=\"stylesheet\" href=\"https://assets-cdn.breezy.hr/breezy-portal/stylesheets/v3/index.css?v=2gft-k10l35\"><link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css?family=Kameron\"><link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css?family=Droid+Sans\"><link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css?family=Lora\"><script src=\"https://assets-cdn.breezy.hr/breezy-portal/dependencies/20170112/jquery.js\"></script><script src=\"https://assets-cdn.breezy.hr/breezy-portal/dependencies/20170112/tooltip.js\"></script><script src=\"https://assets-cdn.breezy.hr/breezy-portal/dependencies/20170112/popover.js\"></script><script src=\"https://assets-cdn.breezy.hr/breezy-portal/dependencies/20170112/smoothscroll.js\"></script><script src=\"https://assets-cdn.breezy.hr/breezy-portal/javascripts/v3/index.js?v=6t5-196s2vi\"></script><link rel=\"stylesheet\" href=\"https://assets-cdn.breezy.hr/breezy-portal/dependencies/20170112/fancybox/source/jquery.fancybox.css\" type=\"text/css\" media=\"screen\"><script type=\"text/javascript\" src=\"https://assets-cdn.breezy.hr/breezy-portal/dependencies/20170112/fancybox/source/jquery.fancybox.pack.js\"></script><script>$(function () {\n\t$('[data-toggle=\"tooltip\"]').tooltip()\n})\n</script><title>SEO/AEO Manager at Growth Marketing Pro, LLC</title><meta name=\"description\" content=\"Growth Marketing Pro began as a leading marketing blog and has since become a growth marketing agency working with 50+ businesses. Technically, we're an agency, but we don't think of ourselves as one. Our clients use us as a fractional SEO/organic growth team: a superpower they plug into their busi\"><link rel=\"canonical\" href=\"https://growth-marketing-pro-llc.breezy.hr/p/dfc12ff9d0e7-seo-aeo-manager\"><meta property=\"og:type\" content=\"website\"><meta property=\"og:image\" content=\"https://growth-marketing-pro-llc.breezy.hr/p/dfc12ff9d0e7-seo-aeo-manager/social/image?linkedin=1792678529142\"><meta property=\"og:title\" content=\"SEO/AEO Manager at Growth Marketing Pro, LLC\"><meta property=\"og:url\" content=\"https://growth-marketing-pro-llc.breezy.hr/p/dfc12ff9d0e7-seo-aeo-manager\"><meta property=\"og:description\" content=\"Growth Marketing Pro began as a leading marketing blog and has since become a growth marketing agency working with 50+ businesses. Technically, we're an agency, but we don't think of ourselves as one. Our clients use us as a fractional SEO/organic growth team: a superpower they plug into their busi\"><meta name=\"twitter:card\" content=\"summary_large_image\"><meta name=\"twitter:title\" content=\"SEO/AEO Manager at Growth Marketing Pro, LLC\"><meta name=\"twitter:description\" content=\"Growth Marketing Pro began as a leading marketing blog and has since become a growth marketing agency working with 50+ businesses. Technically, we're an agency, but we don't think of ourselves as one. Our clients use us as a fractional SEO/organic growth team: a superpower they plug into their busi\"><meta name=\"twitter:image\" content=\"https://growth-marketing-pro-llc.breezy.hr/p/dfc12ff9d0e7-seo-aeo-manager/social/image?linkedin=1792678529142\"><meta name=\"twitter:site\" content=\"@Breezy_HR\"><meta name=\"twitter:label2\" content=\"Company\"><meta name=\"twitter:data2\" content=\"Growth Marketing Pro, LLC\"><meta name=\"twitter:label1\" content=\"Location\"><meta name=\"twitter:data1\" content=\"Remote\"><script type=\"application/ld+json\">{\"@context\":\"http://schema.org\",\"@type\":\"WebSite\",\"name\":\"Breezy HR\",\"alternateName\":\"Breezy HR: Modernize your recruiting process\",\"url\":\"https://breezy.hr/\"}\n</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org/\",\"@type\":\"JobPosting\",\"url\":\"https://growth-marketing-pro-llc.breezy.hr/p/dfc12ff9d0e7-seo-aeo-manager?source=GoogleJobs\",\"title\":\"SEO/AEO Manager\",\"description\":\"<p>Growth Marketing Pro began as a leading marketing blog and has since become a <strong>growth marketing agency working with 50+ businesses</strong>. Technically, we're an agency, but we don't think of ourselves as one. Our clients use us as a fractional SEO/organic growth team: a superpower they plug into their business to unlock fast, profitable growth. </p>\\n<p>We're hiring an <strong>SEO/AEO Account Manager</strong> to deliver WOW results for our organic marketing engagements. Our programs are rooted in SEO and have expanded into what we call Search Everywhere Optimization - AI visibility, citation-earning off-page content, and Reddit organic marketing (we're writing the playbook in these interrelated fields). We deliver on a broader set of organic strategies than anyone else in the game, and bring \\\"ahead of the curve\\\" plays to clients backed by data from across our portfolio.</p>\\n<p>In this role, you'll <strong>directly manage a portfolio of clients</strong>, serving as the point of contact and owner of each engagement. You'll function as a fractional Head of SEO, providing strategic leadership of the client's organic program while personally managing the execution that drives results. You'll leverage your existing marketing experience (SEO, content marketing, analytics) combined with intellectual curiosity and a natural inclination to test cutting-edge tactics - and get the opportunity to <strong>help build a scaling startup into an industry-leading growth marketing company</strong>.</p>\\n<h2><strong>What You'll Own</strong></h2>\\n<ul><li><strong>The client relationship: </strong>serve as the primary point of contact and owner of the engagement end to end; deeply understand the client’s business goals, establish the KPIs and strategy to achieve them, and operate as an extension of their team </li><li><strong>Communicate proactively</strong> with clients and our internal team – regular check-ins between meetings, flagging anomalies early, and keeping clients informed without waiting for a scheduled touchpoint</li><li><strong>The strategy and roadmap:</strong> own the client’s strategy and deliverable roadmap – build monthly strategies grounded in keyword intent with a laser focus on high-intent keywords that convert, sequence the work, and rigorously manage deliverables, milestones, and ETAs across internal teams and vendors</li><li><strong>Execution across SEO and AEO:</strong> SEO and content campaigns built end-to-end with our in-house Content Team, off-page content that earns citations and brand mentions across Reddit, YouTube, and digital PR, and technical site issues identified and resolved with our web dev resources</li><li><strong>Help write the playbook for AI visibility</strong> – how website content, off-site content, and authority drive a brand's presence across Google and AI platforms like ChatGPT and AI Overviews - and recommend and implement A/B tests, CRO improvements, and similar experiments</li><li><strong>Measurement, reporting, and results</strong>: work in Google Search Console, GA4, HubSpot, and AI search performance tools to track changes and extract the learnings that guide your strategy, and tie performance to the bottom line - conversions, pipeline, and revenue</li><li><strong>Deliver detailed monthly reporting</strong> on the KPIs the client actually cares about and be a storyteller: analyze the “why” and “so what” behind the numbers, clearly communicate what’s working, what’s not, and what we should focus on now, next, and later </li><li><strong>Growth beyond the scope</strong>: be a strategic partner beyond the initial scope by suggesting new channel tests, CRO improvements, and tracking setups, and identifying upsell opportunities</li></ul>\\n<h2><strong>What We're Looking For</strong></h2>\\n<ul><li><strong>2+ years delivering revenue growth and business impact through SEO</strong>, ideally including in-house experience at a startup or scaling business where exposure across channels is common</li><li><strong>Fluency in the tools:</strong> Google Search Console, GA4, Ahrefs/Semrush, CRM platforms like HubSpot, and a working familiarity with AI search visibility tracking tools</li><li><strong>Analytical and results-oriented:</strong> you can accurately gather and analyze data to understand SEO + AEO performance. Strong in GA4 and spreadsheets; an \\\"analyst\\\" title somewhere in your background is a plus</li><li><strong>Rigorous execution and GSD:</strong> a bias to action, able to prioritize and execute against a high workload, with keen attention to detail and the ability to keep stakeholders accountable</li><li><strong>Advanced AI adoption:</strong> you're a proficient GPT and Claude user, you use tools like Claude Cowork and Claude Code </li><li><strong>Artful communicator:</strong> strong written and verbal skills, with the ability to tell stories that persuade others to take action. Active listener, sympathetic to the client's situation but unafraid to disagree and offer a counter viewpoint grounded in data</li><li><strong>Extreme ownership:</strong> you treat your clients like your own business. On multi-channel accounts, you stay close to what's happening in other channels, even when they aren't your department</li><li><strong>Not just an SEO, but a broader \\\"Growth Marketing Pro\\\":</strong> you can answer broad strategic growth questions by drawing on experience and pattern matching, hold an informed opinion on CRO and the full funnel, and understand paid search and paid social well enough to advise clients on when and how to use them</li><li><strong>Resourceful with a growth mindset:</strong> you're a pro at teaching yourself new things, you're constantly testing new strategies and documenting the learnings so other clients benefit, and you enjoy the continuous learning process of growth marketing</li></ul>\\n<h3><strong>Bonus points</strong></h3>\\n<ul><li>Experience with Reddit organic marketing, digital PR, or community-led growth</li><li>Hands-on CRO or conversion tracking implementation experience</li><li>Early experimentation with AEO/AI visibility work</li></ul>\\n<p></p>\\n<h2><strong>Benefits</strong></h2>\\n<ul><li><strong>Compensation</strong>: $85,000 – $125,000 per year </li><li><strong>We’re fully remote.</strong> We believe great work happens when people have the freedom to work in the way that works best for them. We trust our team to set their own schedules, do their best work, and get the job done without micromanagement.</li><li><strong>Unlimited PTO + US holidays.</strong> Work-life balance is one of GMP’s core values, and we genuinely live by it. Take the time you need to recharge and enjoy life outside of work.</li><li><strong>Great healthcare benefits.</strong> Choose from a variety of medical plans with dependent coverage, plus dental and vision benefits.</li><li><strong>401 (k) retirement planning. </strong>GMP offers a 401(k) plan with employer contribution, helping you build long-term financial security while you build your career.</li><li><strong>Performance-based compensation.</strong> Your impact matters, and there are opportunities to grow your compensation as you grow and perform.</li><li><strong>Room to grow.</strong> Work alongside talented growth marketers, sharpen your skills, learn from experts, and build your career in the areas that excite you most.</li><li><strong>Make a real impact.</strong> Join a fast-growing startup where your work isn’t just another task on a list—you’ll have a meaningful opportunity to shape the direction and success of the business.</li></ul>\",\"employmentType\":\"FULL_TIME\",\"datePosted\":\"2026-09-02\",\"hiringOrganization\":{\"@type\":\"Organization\",\"name\":\"Growth Marketing Pro, LLC\",\"logo\":null,\"sameAs\":\"https://growth-marketing-pro-llc.breezy.hr\"},\"jobLocation\":{\"@type\":\"Place\",\"address\":{\"@type\":\"PostalAddress\",\"addressCountry\":\"US\"}},\"baseSalary\":{\"@type\":\"MonetaryAmount\",\"currency\":\"USD\",\"value\":{\"@type\":\"QuantitativeValue\",\"unitText\":\"YEAR\",\"minValue\":85000,\"maxValue\":125000}},\"validThrough\":\"2026-10-22T14:15:29.121Z\",\"jobLocationType\":\"TELECOMMUTE\",\"applicantLocationRequirements\":{\"@type\":\"Country\",\"name\":\"US\"}}\n</script><script type=\"text/javascript\" src=\"https://platform-api.sharethis.com/js/sharethis.js#property=643ef4e9c1f1cd00199ca696&amp;product=sop\" async=\"async\"></script><link rel=\"image_src\" href=\"https://growth-marketing-pro-llc.breezy.hr/p/dfc12ff9d0e7-seo-aeo-manager/social/image?linkedin=1792678529142\"><script type=\"text/javascript\" src=\"https://assets-cdn.breezy.hr/breezy-portal/javascripts/v3/polyglot.min.js?v=2bq-1us5ftb\"></script><script id=\"translateScript\" type=\"text/javascript\" src=\"https://assets-cdn.breezy.hr/breezy-portal/javascripts/v3/translate.breezy.js?v=awfw-ecrhol\"></script><script>// INDEED OAUTH FLOW\nvar popup;\nvar breezyUrl=\"https://app.breezy.hr\"\nvar positionId=\"dfc12ff9d0e7\"\n\nfunction popupParams () {\n    var height = 600;\n    var width = 500;\n    var left = (window.screen.width / 2) - ((width / 2) + 10);\n    var top = (window.screen.he