# Import the actual generated values from .secrets/gecko-web-vercel.env in Vercel.
GECKO_SESSION_SECRET=
GECKO_PASSWORD_HASH=
GECKO_BRIDGE_SECRET=
# Default: device (private setup link, remembered browser, no password page).
# Set to password to add the password page later.
GECKO_ACCESS_MODE=device
# Optional on the default production domain; required for a custom domain.
GECKO_PUBLIC_URL=
# Connect an Upstash Redis store to populate these two values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
