# Gecko Job Scout — copy this file to .env.local and add real credentials there.
# Never commit .env.local.

# Default Job Scout provider: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Remotive's official public Jobs API is keyless; no REMOTIVE_API_KEY is used.

# Optional career-page discovery (not used by the default Adzuna search)
# BRAVE_SEARCH_API_KEY=

# Optional legacy Google Custom Search support. Disabled unless explicitly enabled.
# New Google Cloud projects generally do not have access to this legacy API.
GOOGLE_CSE_ENABLED=false
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_ID=

# Optional authorized Indeed integration (not needed for the first search)
# INDEED_API_ENDPOINT=
# INDEED_API_TOKEN=

# Google Sheets is the only job tracker. Enable the Sheets API, store the
# service-account JSON outside this repository, and share the Sheet with its
# client_email as Editor. No local Excel tracker is created or used.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_FILE=
GOOGLE_SHEETS_TRACKER_TAB=Job Tracker
GOOGLE_SHEETS_SCOUT_TAB=Job Scout

# Optional separate copy for scripts/verify_google_tracker.py --write-test.
# Never set this to the live spreadsheet ID.
GOOGLE_SHEETS_TEST_SPREADSHEET_ID=
