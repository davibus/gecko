# Gecko Job Scout — copy this file to .env.local and add real credentials there.
# Never commit .env.local.

# Default Job Scout provider: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Remotive's official public Jobs API is keyless; no REMOTIVE_API_KEY is used.

# Expanded source configuration. The checked-in default enables every compliant
# public source and leaves ATS employer lists empty until you add board IDs.
JOB_SCOUT_SOURCES_CONFIG=job-scout/preferences/job-sources.json
JOB_SCOUT_SOURCE_CONCURRENCY=6
JOB_SCOUT_MAX_RESULTS_PER_SOURCE=50

# Official USAJOBS Search API credentials (request at developer.usajobs.gov).
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# The Muse public API key. The provider remains disabled when this is blank.
THE_MUSE_API_KEY=

# Career-page and Indeed/LinkedIn/Glassdoor/ZipRecruiter search discovery.
# BRAVE_SEARCH_API_KEY=

# Optional legacy Google Custom Search support. Disabled unless explicitly enabled.
# New Google Cloud projects generally do not have access to this legacy API.
GOOGLE_CSE_ENABLED=false
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_ID=

# Optional authorized Indeed integration (not needed for the first search)
# INDEED_API_ENDPOINT=
# INDEED_API_TOKEN=

# Google Sheets is the only job tracker. Enable the Sheets API, store the
# service-account JSON outside this repository, and share the Sheet with its
# client_email as Editor. No local Excel tracker is created or used.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_FILE=
GOOGLE_SHEETS_TRACKER_TAB=Job Tracker
GOOGLE_SHEETS_SCOUT_TAB=Job Scout

# Persistent resume storage. Enable the Google Drive API and share this folder
# with the same service-account client_email as Editor/Content manager.
GOOGLE_DRIVE_RESUME_FOLDER_ID=

# Gmail employer-response tracking uses a separate installed-app OAuth client
# with the single read-only scope: https://www.googleapis.com/auth/gmail.readonly
# Store both files under the ignored .secrets directory.
GECKO_GMAIL_CLIENT_SECRET_FILE=.secrets/gmail-oauth-client.json
GECKO_GMAIL_TOKEN_FILE=.secrets/gmail-oauth-token.json
GECKO_GMAIL_STATE_FILE=job-scout/data/gmail-response-state.json
GECKO_GMAIL_MAX_RESULTS=500
GECKO_GMAIL_REQUEST_DELAY_SECONDS=0.2

# Optional two-stage Job Scout AI evaluation. Leave both Job Scout model values
# blank to preserve the manual-only Apply? workflow without making AI calls.
JOB_SCOUT_TRIAGE_MODEL=
JOB_SCOUT_SCORING_MODEL=
GECKO_RESUME_MODEL=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# JOB_SCOUT_AI_TIMEOUT_SECONDS=60
