# Gecko Job Scout — copy this file to .env.local and add real credentials there.
# Never commit .env.local.

# Default Job Scout provider: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble official Jobs API. Daily searches use Jooble alongside Adzuna.
JOOBLE_API_KEY=

# Remotive's official public Jobs API is keyless; no REMOTIVE_API_KEY is used.

# Optional career-page discovery (not used by the default Adzuna search)
# BRAVE_SEARCH_API_KEY=

# Optional legacy Google Custom Search support (not needed for the first search)
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_ID=

# Optional authorized Indeed integration (not needed for the first search)
# INDEED_API_ENDPOINT=
# INDEED_API_TOKEN=

# Tracker backend. Keep xlsx during setup; switch to google-sheets after verification.
TRACKER_BACKEND=xlsx

# Google Sheets tracker integration. Use a service-account JSON file stored outside
# this repository and share the target spreadsheet with its client_email as Editor.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_FILE=
